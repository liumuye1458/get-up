<Window
    x:Class="CodeXSoundboard.Shell.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Code X Soundboard">

    <Grid Background="{StaticResource ShellWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="{StaticResource ShellChromeBackgroundBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#F3F4F6"
                    Text="Code X Soundboard" />

                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Height="36"
                    PlaceholderText="Search cue cards"
                    TextChanged="SearchBox_TextChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="LeftFilterRail"
                Grid.Column="0"
                Width="{StaticResource ShellLeftRailWidth}"
                Background="{StaticResource ShellLeftRailBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        x:Name="LeftFilterTopZone"
                        Grid.Row="0"
                        Spacing="10">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#E5E7EB" Text="Find cards" />
                        <Button
                            x:Name="AllCardsFilterButton"
                            HorizontalAlignment="Stretch"
                            Click="AllCardsFilterButton_Click"
                            Content="All cue cards" />
                    </StackPanel>

                    <Grid
                        x:Name="LeftFilterTagZone"
                        Grid.Row="1"
                        Margin="0,16,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            FontSize="12"
                            Foreground="#94A3B8"
                            Text="Tags" />

                        <ScrollViewer
                            x:Name="TagFilterScrollViewer"
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto">
                            <StackPanel
                                x:Name="TagFilterPanel"
                                Spacing="8" />
                        </ScrollViewer>
                    </Grid>

                    <StackPanel
                        x:Name="LeftFilterLaterZone"
                        Grid.Row="2"
                        Spacing="8">
                        <TextBlock FontSize="12" Foreground="#64748B" Text="Later" />
                        <Button Content="History" IsEnabled="False" Opacity="0.7" />
                        <Button Content="Backup" IsEnabled="False" Opacity="0.7" />
                        <Button Content="Settings" IsEnabled="False" Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid
                x:Name="CueGridHost"
                Grid.Column="1"
                Background="Transparent"
                AllowDrop="True"
                DragOver="CueGridHost_DragOver"
                Drop="CueGridHost_Drop">
                <GridView
                    x:Name="CueGrid"
                    Margin="16"
                    AllowDrop="True"
                    IsTabStop="False"
                    DragOver="CueGridHost_DragOver"
                    Drop="CueGridHost_Drop"
                    SelectionMode="None">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                ItemWidth="{StaticResource ShellCueCardWidth}"
                                ItemHeight="{StaticResource ShellCueCardHeight}"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="{StaticResource ShellCueCardItemMargin}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="{StaticResource ShellCueCardWidth}"
                                Height="{StaticResource ShellCueCardHeight}"
                                Background="{Binding CardBackground}"
                                BorderBrush="{Binding CardBorderBrush}"
                                BorderThickness="{Binding CardBorderThickness}"
                                CornerRadius="10"
                                Padding="12"
                                Opacity="{Binding CardOpacity}"
                                RightTapped="CueCard_RightTapped"
                                Tapped="CueCard_Tapped">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding TitleBrush}"
                                        MaxLines="1"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />

                                    <Border
                                        Grid.Column="1"
                                        Width="12"
                                        Height="12"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="{Binding AccentBrush}"
                                        CornerRadius="999" />

                                    <TextBlock
                                        Grid.Row="2"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding HotkeyBrush}"
                                        Text="{Binding Hotkey}" />

                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Background="{Binding StatusBackground}"
                                        CornerRadius="999"
                                        Padding="8,2">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{Binding StatusForeground}"
                                            Text="{Binding StatusText}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Border
                    x:Name="EmptyStatePanel"
                    Margin="16"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource ShellEmptyStateBackgroundBrush}"
                    BorderBrush="{StaticResource ShellEmptyStateBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="EmptyStateText"
                        Foreground="#F9FAFB"
                        Text="No matching cards" />
                </Border>
            </Grid>

            <Border
                x:Name="EditorDrawer"
                Grid.Column="2"
                Width="{StaticResource ShellEditorDrawerWidth}"
                Background="{StaticResource ShellDrawerBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="EditorDrawerHeader"
                        Grid.Row="0"
                        Height="{StaticResource ShellEditorDrawerHeaderHeight}"
                        Padding="16,10"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="DrawerTitleText"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#F9FAFB"
                                Text="Edit cue" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    x:Name="DrawerSubtitleText"
                                    Foreground="#94A3B8"
                                    Text="No cue selected" />
                                <Border
                                    x:Name="DrawerSaveStateBadge"
                                    Background="#1E293B"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="8,2">
                                    <TextBlock
                                        x:Name="DrawerSaveStateText"
                                        Foreground="#CBD5E1"
                                        Text="No changes" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button
                            x:Name="SaveCueButton"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            MinWidth="84"
                            Content="Save"
                            Click="SaveCueButton_Click" />

                        <Button
                            x:Name="CloseDrawerButton"
                            Grid.Column="2"
                            MinWidth="72"
                            Content="Close"
                            Click="CloseDrawerButton_Click" />
                    </Grid>

                    <ScrollViewer
                        x:Name="EditorDrawerBodyScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Auto">
                        <StackPanel
                            x:Name="EditorDrawerBodyPanel"
                            Padding="16"
                            Spacing="12">
                            <Border
                                x:Name="BasicInfoSection"
                                MinHeight="144"
                                Background="#18212B"
                                BorderBrush="#2B3643"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#F9FAFB" Text="Basic info" />
                                    <TextBox
                                        x:Name="CueNameTextBox"
                                        Header="Display name"
                                        Height="40"
                                        MaxLength="48"
                                        PlaceholderText="Cue name"
                                        TextChanged="CueNameTextBox_TextChanged" />
                                    <TextBlock
                                        x:Name="CueNameValidationText"
                                        Foreground="#FCA5A5"
                                        Text="Name validation appears here"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="Collapsed" />
                                    <TextBox
                                        x:Name="CueTagsTextBox"
                                        Header="Tags"
                                        PlaceholderText="Comma-separated tags"
                                        TextChanged="CueTagsTextBox_TextChanged" />
                                    <ScrollViewer
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Disabled"
                                        VerticalScrollMode="Disabled">
                                        <StackPanel
                                            x:Name="SelectedTagChipPanel"
                                            Orientation="Horizontal"
                                            Spacing="8" />
                                    </ScrollViewer>
                                    <StackPanel Spacing="8">
                                        <TextBlock FontSize="12" Foreground="#94A3B8" Text="Color" />
                                        <Grid x:Name="ColorPresetGrid">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="ColorButtonSlate" Grid.Row="0" Grid.Column="0" Width="28" Height="28" Margin="0,0,8,8" Background="#64748B" BorderBrush="#CBD5E1" BorderThickness="1" Click="ColorButton_Click" CornerRadius="999" Tag="slate" />
                                            <Button x:Name="ColorButtonRed" Grid.Row="0" Grid.Column="1" Width="28" Height="28" Margin="0,0,8,8" Background="#EF4444" BorderBrush="#CBD5E1" BorderThickness="1" Click="ColorButton_Click" CornerRadius="999" Tag="red" />
                                            <Button x:Name="ColorButtonOrange" Grid.Row="0" Grid.Column="2" Width="28" Height="28" Margin="0,0,0,8" Background="#F97316" BorderBrush="#CBD5E1" BorderThickness="1" Click="ColorButton_Click" CornerRadius="999" Tag="orange" />
                                            <Button x:Name="ColorButtonAmber" Grid.Row="1" Grid.Column="0" Width="28" Height="28" Margin="0,0,8,8" Background="#F59E0B" BorderBrush="#CBD5E1" BorderThickness="1" Click="ColorButton_Click" CornerRadius="999" Tag="amber" />
                                            <Button x:Name="ColorButtonLime" Grid.Row="1" Grid.Column="1" Width="28" Height="28" Margin="0,0,8,8" Background="#84CC16" BorderBrush="#CBD5E1" BorderThickness="1" Click="ColorButton_Click" CornerRadius="999" Tag="lime" />
                                            <Button x:Name="ColorButtonEmerald" Grid.Row="1" Grid.Column="2" Width="28" Height="28" Margin="0,0,0,8" Background="#10B981" BorderBrush="#CBD5E1" BorderThickness="1" Click="ColorButton_Click" CornerRadius="999" Tag="emerald" />
                                            <Button x:Name="ColorButtonSky" Grid.Row="2" Grid.Column="0" Width="28" Height="28" Margin="0,0,8,0" Background="#0EA5E9" BorderBrush="#CBD5E1" BorderThickness="1" Click="ColorButton_Click" CornerRadius="999" Tag="sky" />
                                            <Button x:Name="ColorButtonIndigo" Grid.Row="2" Grid.Column="1" Width="28" Height="28" Margin="0,0,8,0" Background="#6366F1" BorderBrush="#CBD5E1" BorderThickness="1" Click="ColorButton_Click" CornerRadius="999" Tag="indigo" />
                                            <Button x:Name="ColorButtonRose" Grid.Row="2" Grid.Column="2" Width="28" Height="28" Margin="0" Background="#F43F5E" BorderBrush="#CBD5E1" BorderThickness="1" Click="ColorButton_Click" CornerRadius="999" Tag="rose" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="ColorSelectionText"
                                            Foreground="#94A3B8"
                                            Text="Selected color: Sky" />
                                    </StackPanel>
                                    <Border
                                        Background="#121820"
                                        BorderBrush="#2B3643"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10">
                                        <Grid ColumnSpacing="10" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#94A3B8" Text="File" />
                                            <TextBlock x:Name="ResourceFileNameText" Grid.Row="0" Grid.Column="1" Foreground="#E5E7EB" Text="entrance-hit.wav" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Foreground="#94A3B8" Text="Source" />
                                            <TextBlock x:Name="ResourceSourceText" Grid.Row="1" Grid.Column="1" Foreground="#E5E7EB" Text="Local import" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Foreground="#94A3B8" Text="Duration" />
                                            <TextBlock x:Name="ResourceDurationText" Grid.Row="2" Grid.Column="1" Foreground="#E5E7EB" Text="2.40 s" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="HotkeySection"
                                MinHeight="118"
                                Background="#18212B"
                                BorderBrush="#2B3643"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#F9FAFB" Text="Hotkey" />
                                    <TextBox
                                        x:Name="CueHotkeyTextBox"
                                        Header="Assigned hotkey"
                                        IsReadOnly="True"
                                        KeyDown="CueHotkeyTextBox_KeyDown"
                                        Text="Ctrl + 1" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="RecordHotkeyButton"
                                            HorizontalAlignment="Left"
                                            Content="Record hotkey"
                                            Click="RecordHotkeyButton_Click" />
                                        <Button
                                            x:Name="ClearHotkeyButton"
                                            HorizontalAlignment="Left"
                                            Content="Clear"
                                            Click="ClearHotkeyButton_Click" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="HotkeyStateText"
                                        Foreground="#94A3B8"
                                        Text="Supports Ctrl, Alt, Shift with letters, digits, or function keys." />
                                    <TextBlock
                                        x:Name="HotkeyValidationText"
                                        Foreground="#FCA5A5"
                                        Text="Hotkey conflict appears here"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="PlaybackParametersSection"
                                MinHeight="150"
                                Background="#18212B"
                                BorderBrush="#2B3643"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#F9FAFB" Text="Playback parameters" />
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#E5E7EB" Text="Volume" />
                                            <TextBlock
                                                x:Name="CueVolumeValueText"
                                                Grid.Column="1"
                                                Foreground="#F9FAFB"
                                                Text="100%" />
                                        </Grid>
                                        <Slider
                                            x:Name="CueVolumeSlider"
                                            Minimum="0"
                                            Maximum="100"
                                            SmallChange="1"
                                            LargeChange="10"
                                            StepFrequency="1"
                                            Value="100"
                                            ValueChanged="CueVolumeSlider_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#E5E7EB" Text="Playback rate" />
                                            <TextBlock
                                                x:Name="CuePlaybackRateValueText"
                                                Grid.Column="1"
                                                Foreground="#F9FAFB"
                                                Text="1.0x" />
                                        </Grid>
                                        <Slider
                                            x:Name="CuePlaybackRateSlider"
                                            Minimum="0.5"
                                            Maximum="1.5"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            StepFrequency="0.05"
                                            Value="1.0"
                                            ValueChanged="CuePlaybackRateSlider_ValueChanged" />
                                    </StackPanel>
                                    <TextBlock
                                        Foreground="#94A3B8"
                                        Text="Volume and rate preview immediately. Save is still required before writing the cue." 
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="TrimAndWaveformSection"
                                Background="#18212B"
                                BorderBrush="#2B3643"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="#F9FAFB"
                                            Text="Trim and waveform" />

                                        <Button
                                            x:Name="TrimSectionToggleButton"
                                            Grid.Column="1"
                                            Content="Expand"
                                            Click="ToggleTrimSectionButton_Click" />
                                    </Grid>

                                    <TextBlock
                                        x:Name="TrimSectionHintText"
                                        Foreground="#94A3B8"
                                        Text="Collapsed by default. Expand only when trim editing is needed." />

                                    <TextBlock
                                        x:Name="TrimSummaryText"
                                        Foreground="#CBD5E1"
                                        Text="Full clip | 0.00 s -> 2.40 s" />

                                    <StackPanel
                                        x:Name="TrimSectionContent"
                                        Visibility="Collapsed"
                                        Spacing="10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox
                                                x:Name="TrimStartTextBox"
                                                Grid.Column="0"
                                                Header="Trim start"
                                                Text="0.00 s"
                                                LostFocus="TrimBoundaryTextBox_LostFocus"
                                                TextChanged="TrimBoundaryTextBox_TextChanged" />
                                            <TextBox
                                                x:Name="TrimEndTextBox"
                                                Grid.Column="1"
                                                Header="Trim end"
                                                Text="2.40 s"
                                                LostFocus="TrimBoundaryTextBox_LostFocus"
                                                TextChanged="TrimBoundaryTextBox_TextChanged" />
                                        </Grid>

                                        <TextBlock
                                            x:Name="TrimValidationText"
                                            Foreground="#FCA5A5"
                                            Text="Trim validation appears here"
                                            TextWrapping="WrapWholeWords"
                                            Visibility="Collapsed" />

                                        <Border
                                            Height="140"
                                            Background="#0F1318"
                                            BorderBrush="#2B3643"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid Padding="12" RowSpacing="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        x:Name="WaveformStartTimeText"
                                                        Foreground="#CBD5E1"
                                                        Text="0.00 s" />

                                                    <TextBlock
                                                        x:Name="WaveformRangeText"
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Center"
                                                        Foreground="#E2E8F0"
                                                        Text="Trimmed range | 0.00 s -> 2.40 s" />

                                                    <TextBlock
                                                        x:Name="WaveformTotalDurationText"
                                                        Grid.Column="2"
                                                        Foreground="#CBD5E1"
                                                        Text="Total 2.40 s" />
                                                </Grid>

                                                <Grid
                                                    x:Name="WaveformInteractionSurface"
                                                    Grid.Row="1"
                                                    SizeChanged="WaveformInteractionSurface_SizeChanged">
                                                    <Border
                                                        x:Name="WaveformTimelineTrackArea"
                                                        Margin="12,8"
                                                        Background="#111827"
                                                        CornerRadius="6" />

                                                    <Border
                                                        x:Name="WaveformSelectionBand"
                                                        Margin="12,8,12,8"
                                                        HorizontalAlignment="Left"
                                                        Background="#1D4ED8"
                                                        CornerRadius="6"
                                                        Width="0">
                                                        <Grid>
                                                            <TextBlock
                                                                x:Name="WaveformHighlightText"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="#EFF6FF"
                                                                Text="Highlighted trim range" />
                                                        </Grid>
                                                    </Border>

                                                    <Border
                                                        x:Name="WaveformStartHandleHitArea"
                                                        Width="24"
                                                        Margin="12,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Background="Transparent"
                                                        PointerCaptureLost="TrimHandle_PointerCaptureLost"
                                                        PointerMoved="TrimHandle_PointerMoved"
                                                        PointerPressed="TrimHandle_PointerPressed"
                                                        PointerReleased="TrimHandle_PointerReleased"
                                                        Tag="start"
                                                        ToolTipService.ToolTip="Start handle: 12 px visual width, 24 px hit target.">
                                                        <Border
                                                            Width="12"
                                                            HorizontalAlignment="Left"
                                                            Background="#93C5FD"
                                                            CornerRadius="999" />
                                                    </Border>

                                                    <Border
                                                        x:Name="WaveformEndHandleHitArea"
                                                        Width="24"
                                                        Margin="12,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Background="Transparent"
                                                        PointerCaptureLost="TrimHandle_PointerCaptureLost"
                                                        PointerMoved="TrimHandle_PointerMoved"
                                                        PointerPressed="TrimHandle_PointerPressed"
                                                        PointerReleased="TrimHandle_PointerReleased"
                                                        Tag="end"
                                                        ToolTipService.ToolTip="End handle: 12 px visual width, 24 px hit target.">
                                                        <Border
                                                            Width="12"
                                                            HorizontalAlignment="Right"
                                                            Background="#93C5FD"
                                                            CornerRadius="999" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock
                                                    x:Name="WaveformHandleRuleText"
                                                    Grid.Row="2"
                                                    HorizontalAlignment="Center"
                                                    Foreground="#64748B"
                                                    Text="Handles clamp to the nearest legal range, never cross, and never retarget the opposite side mid-drag." />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="DangerZoneSection"
                                MinHeight="104"
                                Background="#2A1719"
                                BorderBrush="#5A2B31"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#FECACA" Text="Danger zone" />
                                    <TextBlock
                                        x:Name="DangerZoneHintText"
                                        Foreground="#FCA5A5"
                                        Text="Dangerous actions stay at the bottom of the drawer, follow body scroll, and never compete with the main edit path."
                                        TextWrapping="WrapWholeWords" />
                                    <Button
                                        x:Name="DuplicateCueButton"
                                        HorizontalAlignment="Stretch"
                                        Content="Duplicate as new cue"
                                        Click="DuplicateCueButton_Click" />
                                    <Border
                                        Height="1"
                                        Background="#5A2B31"
                                        Opacity="0.9" />
                                    <Button
                                        x:Name="DeleteCueButton"
                                        HorizontalAlignment="Stretch"
                                        Background="#7F1D1D"
                                        BorderBrush="#FCA5A5"
                                        Foreground="#FEE2E2"
                                        Content="Delete cue"
                                        Click="DeleteCueButton_Click" />
                                    <TextBlock
                                        Foreground="#FCA5A5"
                                        Text="Delete stays last, requires confirmation, and can stop current playback if this cue is active."
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border
            x:Name="BottomControlStrip"
            Grid.Row="2"
            Background="{StaticResource ShellChromeBackgroundBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,10">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ToggleSwitch
                    x:Name="GlobalHotkeyToggle"
                    Grid.Column="0"
                    Header="Global hotkeys"
                    Toggled="GlobalHotkeyToggle_Toggled" />

                <Button
                    x:Name="PlayPauseButton"
                    Grid.Column="1"
                    MinWidth="110"
                    Content="Play"
                    Click="PlayPauseButton_Click" />

                <StackPanel Grid.Column="2" Spacing="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="#E5E7EB" Text="Volume" />
                        <TextBlock
                            x:Name="MasterVolumeValueText"
                            Grid.Column="1"
                            Foreground="#F9FAFB"
                            Text="76%" />
                    </Grid>
                    <Slider
                        x:Name="VolumeSlider"
                        Minimum="0"
                        Maximum="100"
                        StepFrequency="1"
                        Value="76"
                        ValueChanged="VolumeSlider_ValueChanged" />
                </StackPanel>

                <ToggleSwitch
                    x:Name="RepeatPlaybackToggle"
                    Grid.Column="3"
                    Header="Repeat"
                    Toggled="RepeatPlaybackToggle_Toggled" />

                <TextBlock
                    x:Name="StatusHintText"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Foreground="#94A3B8"
                    Text="Main window shell frozen: fixed logical size, cards change by column count only." />
            </Grid>
        </Border>
    </Grid>
</Window>
